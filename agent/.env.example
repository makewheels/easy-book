# book-agent 配置示例：复制为 .env 使用（.env 已被 gitignore）

# ── LLM（OpenAI 兼容接口，默认 DashScope）──
# BOOK_AGENT_PROVIDER=dashscope
BOOK_AGENT_LLM_API_KEY=sk-xxxx
# BOOK_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BOOK_AGENT_LLM_MODEL=qwen-plus

# ── easy-book 后端 ─
EASY_BOOK_API_URL=http://localhost:8002

# 写操作免确认（慎用）：true 时 create/update/delete/签到 直接执行
# BOOK_AGENT_CONFIRM_WRITE=false
